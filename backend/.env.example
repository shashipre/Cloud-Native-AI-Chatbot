# Database
DATABASE_URL=postgresql://chatbot_user:chatbot_password@localhost:5432/chatbot_db

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AWS S3 (optional for local dev — uploads are mocked without these)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Google Gemini (free tier — get key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
